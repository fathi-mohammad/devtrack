              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/reporters/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "reporters"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"Asha Nair\",\n  \"email\": \"asha@devtrack.io\",\n  \"team\": \"backend\"\n}"
